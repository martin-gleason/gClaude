# Required
ANTHROPIC_API_KEY=sk-ant-xxx

# Required for webhook auth
GMAIL_WEBHOOK_SECRET=your-secret-here

# Optional — per-environment overrides applied at deploy time
AUTHORIZED_USERS=                          # prod: prod allowlist | dev: dev allowlist
DEFAULT_MODEL=claude-sonnet-4-5-20250929
COMPLEX_MODEL=
MAX_XLSX_SIZE_MB=10
MAX_PREVIEW_ROWS=50
LOG_LEVEL=INFO                             # prod: INFO | dev: DEBUG
DAILY_BUDGET_USD=5.00                      # prod: 5.00 | dev: 1.00

# Google Chat
GOOGLE_CHAT_PROJECT_NUMBER=                # prod: (prod bot) | dev: (dev bot)
MENTION_TRIGGER=true
THREAD_CONTEXT_TTL_SECONDS=3600
THREAD_CONTEXT_MAX_ENTRIES=500
THREAD_CONTEXT_MAX_TURNS=10

# Google Chat — attachment downloads (leave empty to disable or use Workload Identity)
GOOGLE_CHAT_SERVICE_ACCOUNT_FILE=

# GCS — file generation storage (leave empty to disable file generation)
GCS_BUCKET_NAME=                           # prod: gclaude-prod-files | dev: gclaude-dev-files
GCS_SIGNED_URL_EXPIRATION_HOURS=24
GCS_GENERATED_FILES_PREFIX=generated/
GCS_SERVICE_ACCOUNT_FILE=

# Web Chat (Apps Script frontend)
WEB_CHAT_SECRET=                           # shared bearer token for /web-chat endpoint
MAX_CONVERSATION_HISTORY_PAIRS=20          # max Q&A pairs sent per request

# Timeouts & retention
CLAUDE_TIMEOUT_SECONDS=60
FILE_RETENTION_HOURS=24
